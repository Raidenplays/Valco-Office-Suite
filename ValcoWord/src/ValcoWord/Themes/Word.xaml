<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Office 2007-style blue workspace behind the page -->
    <LinearGradientBrush x:Key="WorkspaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFBACBE0" Offset="0"/>
        <GradientStop Color="#FFA4B9D3" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="PageShadow" BlurRadius="9" ShadowDepth="2" Direction="300" Opacity="0.45" Color="#FF2A3A50"/>

    <Style x:Key="FmtBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource LightBarBrush}"/>
        <Setter Property="BorderBrush" Value="#FFB6C3D3"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="4,3,4,3"/>
    </Style>
    <Style x:Key="FmtSep" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="#FFB3C2D4"/>
        <Setter Property="Background" Value="#FFFFFFFF"/>
    </Style>
    <Style x:Key="BarCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlyphText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Times New Roman"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#FF1E2B3A"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,-2,0,0"/>
    </Style>
    <Style x:Key="StatusText" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Foreground" Value="#FF1E3957"/>
    </Style>
    <Style x:Key="StatusSep" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="0,3"/>
        <Setter Property="Background" Value="#FFAFC0D4"/>
    </Style>
    <Style x:Key="StatusButton" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource FmtButton}">
        <Setter Property="Height" Value="20"/>
        <Setter Property="MinWidth" Value="20"/>
        <Setter Property="Padding" Value="3,0"/>
    </Style>
    <Style x:Key="DropArrow" TargetType="{x:Type Path}">
        <Setter Property="Data" Value="M0,0 L5,0 L2.5,3 Z"/>
        <Setter Property="Fill" Value="#FF2E3D50"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="3,1,0,0"/>
    </Style>
    <Style x:Key="CmdDropArrow" TargetType="{x:Type Path}" BasedOn="{StaticResource DropArrow}">
        <Setter Property="Fill" Value="White"/>
    </Style>
</ResourceDictionary>
