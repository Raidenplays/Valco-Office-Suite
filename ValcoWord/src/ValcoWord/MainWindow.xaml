<local:VistaWindow x:Class="ValcoWord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ValcoWord"
        Title="Document1 - Valco Word" Width="1100" Height="780" MinWidth="640" MinHeight="420" AllowDrop="True">
    <DockPanel x:Name="Root">
        <!-- ===================== Ribbon (built in MainWindow.Ribbon.cs) ===================== -->
        <Grid x:Name="RibbonHost" DockPanel.Dock="Top"/>

        <!-- ===================== Message bar (Mark as Final / protection / mail merge) ===================== -->
        <Border x:Name="MessageBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFFFF6C9" BorderBrush="#FFE2C77A" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel>
                <Button x:Name="MessageBarButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="6,0,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource IconInfo}" Width="16" Height="16" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MessageBarText" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Ruler ===================== -->
        <local:Ruler x:Name="TheRuler" DockPanel.Dock="Top"/>

        <!-- ===================== Status bar ===================== -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource Rb.Status}" BorderBrush="#FF8DA6C7" BorderThickness="0,1,0,0" Height="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel x:Name="ViewButtons" Orientation="Horizontal" Margin="0,0,6,0"/>
                    <Border Style="{StaticResource StatusSep}"/>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomDialog_Click" ToolTip="Zoom level" Margin="4,0,0,0">
                        <TextBlock x:Name="ZoomText" Text="100%" Width="38" TextAlignment="Center" Foreground="{DynamicResource Rb.StatusText}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomOut_Click" ToolTip="Zoom Out"><Path Data="M0,0 H8 V2 H0 Z" Fill="{DynamicResource Rb.StatusText}"/></Button>
                    <Slider x:Name="ZoomSlider" Width="110" Minimum="10" Maximum="500" Value="100" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomIn_Click" ToolTip="Zoom In" Margin="0,0,6,0"><Path Data="M3,0 H5 V3 H8 V5 H5 V8 H3 V5 H0 V3 H3 Z" Fill="{DynamicResource Rb.StatusText}"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Rb.StatusText}">
                    <Button Style="{StaticResource StatusButton}" Click="GoTo_Click" ToolTip="Page number in document. Click to open the Go To dialog box.">
                        <TextBlock x:Name="PageText" Text="Page: 1 of 1" Margin="4,0" Foreground="{DynamicResource Rb.StatusText}"/>
                    </Button>
                    <Border Style="{StaticResource StatusSep}"/>
                    <Button Style="{StaticResource StatusButton}" Click="WordCount_Click" ToolTip="Number of words in document. Click to open the Word Count dialog box.">
                        <TextBlock x:Name="WordsText" Text="Words: 0" Foreground="{DynamicResource Rb.StatusText}" Margin="4,0"/>
                    </Button>
                    <Border Style="{StaticResource StatusSep}"/>
                    <Button x:Name="BtnSpellStatus" Style="{StaticResource StatusButton}" Click="SpellingDialog_Click" ToolTip="Proofing">
                        <Image x:Name="SpellStatusIcon" Source="{StaticResource IconSpelling}" Width="16" Height="16"/>
                    </Button>
                    <Border Style="{StaticResource StatusSep}"/>
                    <TextBlock Text="English (Canada)" VerticalAlignment="Center" Margin="8,0"/>
                    <Border Style="{StaticResource StatusSep}"/>
                    <Button x:Name="TrackStatus" Style="{StaticResource StatusButton}" Click="TrackStatus_Click" ToolTip="Track Changes">
                        <TextBlock x:Name="TrackStatusText" Text="Track Changes: Off" Foreground="{DynamicResource Rb.StatusText}" Margin="4,0"/>
                    </Button>
                    <Border Style="{StaticResource StatusSep}"/>
                    <TextBlock x:Name="StatusMsg" Text="" VerticalAlignment="Center" Margin="8,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Work area with side panes ===================== -->
        <Grid x:Name="WorkArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCol" Width="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="RightCol" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="LeftPane" Grid.Column="0" Background="White" BorderBrush="#FF8DA6C7" BorderThickness="0,0,1,0" Visibility="Collapsed"/>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" ResizeBehavior="PreviousAndNext" Background="#FFC8D8EE" Visibility="Collapsed"/>
            <ScrollViewer x:Name="Scroller" Grid.Column="2" Background="{DynamicResource Rb.Workspace}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                          Focusable="False" PreviewMouseWheel="Scroller_PreviewMouseWheel" ScrollChanged="Scroller_ScrollChanged">
                <Grid x:Name="PageHost" MouseLeftButtonDown="PageHost_MouseDown" Background="Transparent">
                    <Border x:Name="Page" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,20,24,32"
                            BorderBrush="#FF8EA2BC" BorderThickness="0.5" Effect="{StaticResource PageShadow}">
                        <Border.LayoutTransform>
                            <ScaleTransform x:Name="PageScale" ScaleX="1" ScaleY="1"/>
                        </Border.LayoutTransform>
                        <Grid x:Name="PageGrid">
                            <Canvas x:Name="Underlay" IsHitTestVisible="False" ClipToBounds="True"/>
                            <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent" Padding="0" AcceptsTab="True"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                         SpellCheck.IsEnabled="True" IsDocumentEnabled="False" Language="en-US"
                                         FocusVisualStyle="{x:Null}" AutoWordSelection="True" IsInactiveSelectionHighlightEnabled="True"/>
                            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="4" ResizeBehavior="PreviousAndNext" Background="#FFC8D8EE" Visibility="Collapsed"/>
            <Border x:Name="RightPane" Grid.Column="4" Background="White" BorderBrush="#FF8DA6C7" BorderThickness="1,0,0,0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</local:VistaWindow>
