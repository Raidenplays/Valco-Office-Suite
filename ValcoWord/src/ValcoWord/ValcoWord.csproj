<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ValcoWord</AssemblyName>
    <RootNamespace>ValcoWord</RootNamespace>
    <ApplicationIcon>..\..\assets\ValcoWord.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Valco Word</Product>
    <Company>ItsRaiden</Company>
    <Copyright>© 2026 ItsRaiden</Copyright>
    <Description>Valco Word</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1998;CS4014;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\ValcoWord.ico" Link="ValcoWord.ico" />
    <EmbeddedResource Include="..\..\assets\thesaurus.gz" LogicalName="thesaurus.gz" />
  </ItemGroup>
  <ItemGroup>
    <!-- old copies, now shared in ValcoCommon -->
    <Compile Remove="Ribbon.cs" />
    <Page Remove="Themes\Icons.xaml;Themes\VistaChrome.xaml.new" />
  </ItemGroup>
  <Import Project="..\..\..\ValcoCommon\ValcoCommon.props" />
</Project>
