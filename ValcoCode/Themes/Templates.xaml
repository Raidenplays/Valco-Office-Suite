<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Explorer rows -->
    <HierarchicalDataTemplate x:Key="FileNodeTemplate" ItemsSource="{Binding Children}">
        <DockPanel Height="22" Background="Transparent" ToolTip="{Binding FullPath}">
            <Border DockPanel.Dock="Right" MinWidth="16" Margin="4,0,8,0" Visibility="{Binding BadgeVisibility}">
                <TextBlock Text="{Binding Badge}" Foreground="{Binding NameBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="{Binding IconFont}" FontSize="{Binding IconSize}" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Name}" Foreground="{Binding NameBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextDecorations="{Binding Decorations}" />
        </DockPanel>
    </HierarchicalDataTemplate>

    <!-- Search results -->
    <HierarchicalDataTemplate x:Key="SearchNodeTemplate" ItemsSource="{Binding Children}">
        <DockPanel Height="22" Background="Transparent" ToolTip="{Binding Tip}">
            <Border DockPanel.Dock="Right" Style="{StaticResource CountBadge}" Margin="4,0,8,0" Visibility="{Binding CountVisibility}">
                <TextBlock Text="{Binding Count}" FontSize="10" Foreground="{DynamicResource BadgeFgBrush}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe UI Symbol, Segoe UI" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding CountVisibility}" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" Background="{DynamicResource SelectionBrush}" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" /><Run Text="{Binding Dir, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </TextBlock>
        </DockPanel>
    </HierarchicalDataTemplate>

    <!-- Source control rows -->
    <DataTemplate x:Key="GitRowTemplate">
        <DockPanel Height="22" Background="Transparent" ToolTip="{Binding Path}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Letter}" Foreground="{Binding LetterBrush}" FontWeight="SemiBold" Width="16" TextAlignment="Center" VerticalAlignment="Center" Margin="2,0,6,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding ActionsVisibility}">
                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="Open File" Tag="open" Padding="2,0" Visibility="{Binding OpenVisibility}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" ToolTip="Discard Changes" Tag="discard" Padding="2,0" Visibility="{Binding DiscardVisibility}" />
                <Button Style="{StaticResource IconButton}" Content="{Binding StageGlyph}" ToolTip="{Binding StageTip}" Tag="stage" Padding="2,0" />
            </StackPanel>
            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name, Mode=OneWay}" Foreground="{Binding LetterBrush}" TextDecorations="{Binding Decorations}" /><Run Text="{Binding DirText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </TextBlock>
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="CommitTemplate">
        <StackPanel Margin="0,2" ToolTip="{Binding Hash}">
            <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
            <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Short, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" · " /><Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Date, Mode=OneWay}" /><Run Text="{Binding RefsText, Mode=OneWay}" Foreground="{DynamicResource TabAccentBrush}" />
            </TextBlock>
        </StackPanel>
    </DataTemplate>

    <!-- Problems -->
    <DataTemplate x:Key="ProblemTemplate">
        <DockPanel Height="22" Background="Transparent">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Width="22" VerticalAlignment="Center" Margin="{Binding Indent}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
            <TextBlock Text="{Binding Text}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </DataTemplate>

    <!-- Command palette rows -->
    <DataTemplate x:Key="PickTemplate">
        <DockPanel MinHeight="24" Background="Transparent">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" Opacity="0.65" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding IconBrush}" Width="22" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Label, Mode=OneWay}" /><Run Text="{Binding DescriptionText, Mode=OneWay}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.65" Visibility="{Binding DetailVisibility}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
