<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared Valco Office window chrome (Aero glass frame), copied from Valco Word so every app looks the same. -->
    <!-- ===================== Glass frame ===================== -->
    <LinearGradientBrush x:Key="GlassFrameBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,64">
        <GradientStop Color="#FFC4D7EC" Offset="0"/>
        <GradientStop Color="#FFA7C0DD" Offset="0.42"/>
        <GradientStop Color="#FF8EABCD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFrameInactiveBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,64">
        <GradientStop Color="#FFE0E8F1" Offset="0"/>
        <GradientStop Color="#FFCFDAE6" Offset="0.42"/>
        <GradientStop Color="#FFC3D0DE" Offset="1"/>
    </LinearGradientBrush>
    <StaticResource x:Key="Rb.Frame" ResourceKey="GlassFrameBrush"/>
    <StaticResource x:Key="Rb.FrameInactive" ResourceKey="GlassFrameInactiveBrush"/>
    <SolidColorBrush x:Key="Rb.FrameText" Color="#FF0B0F14"/>
    <SolidColorBrush x:Key="Rb.FrameBorder" Color="#FF26323F"/>
    <LinearGradientBrush x:Key="GlassStreakBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.18"/>
        <GradientStop Color="#38FFFFFF" Offset="0.215"/>
        <GradientStop Color="#14FFFFFF" Offset="0.26"/>
        <GradientStop Color="#00FFFFFF" Offset="0.29"/>
        <GradientStop Color="#00FFFFFF" Offset="0.52"/>
        <GradientStop Color="#2CFFFFFF" Offset="0.555"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        <GradientStop Color="#00FFFFFF" Offset="0.78"/>
        <GradientStop Color="#22FFFFFF" Offset="0.805"/>
        <GradientStop Color="#00FFFFFF" Offset="0.85"/>
    </LinearGradientBrush>

    <!-- caption buttons -->
    <LinearGradientBrush x:Key="CapNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D8EAF2FB" Offset="0"/>
        <GradientStop Color="#A8C4D6EA" Offset="0.45"/>
        <GradientStop Color="#9091AACB" Offset="0.5"/>
        <GradientStop Color="#B0B7CDE5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEAF8FF" Offset="0"/>
        <GradientStop Color="#FFB4E2FB" Offset="0.45"/>
        <GradientStop Color="#FF5FC0EF" Offset="0.5"/>
        <GradientStop Color="#FF9CEAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF9CC6E6" Offset="0"/>
        <GradientStop Color="#FF5B97C8" Offset="0.45"/>
        <GradientStop Color="#FF2A6BA3" Offset="0.5"/>
        <GradientStop Color="#FF4C98CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapCloseNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE9AE9F" Offset="0"/>
        <GradientStop Color="#FFDA8571" Offset="0.45"/>
        <GradientStop Color="#FFC34A30" Offset="0.5"/>
        <GradientStop Color="#FFD9785B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapCloseHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFC9B9" Offset="0"/>
        <GradientStop Color="#FFF48C70" Offset="0.45"/>
        <GradientStop Color="#FFE5401B" Offset="0.5"/>
        <GradientStop Color="#FFFBA27B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapClosePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFCA7C69" Offset="0"/>
        <GradientStop Color="#FFB14A31" Offset="0.45"/>
        <GradientStop Color="#FF8E2310" Offset="0.5"/>
        <GradientStop Color="#FFB2502D" Offset="1"/>
    </LinearGradientBrush>
    <CornerRadius x:Key="CrLeft">0,0,0,4</CornerRadius>
    <CornerRadius x:Key="CrNone">0</CornerRadius>
    <CornerRadius x:Key="CrRight">0,0,4,0</CornerRadius>
    <CornerRadius x:Key="CrBoth">0,0,4,4</CornerRadius>

    <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Background" Value="{StaticResource CapNormal}"/>
        <Setter Property="Tag" Value="{StaticResource CrNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF34465C" BorderThickness="1,0,1,1"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <Border BorderBrush="#77FFFFFF" BorderThickness="1,0,1,1"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CapHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource CapPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="43"/>
        <Setter Property="Background" Value="{StaticResource CapCloseNormal}"/>
        <Setter Property="Tag" Value="{StaticResource CrRight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CapCloseHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource CapClosePressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GlyphPath" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="#FF1F2C3B"/>
        <Setter Property="StrokeThickness" Value="0.9"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== Vista window ===================== -->
    <Style x:Key="VistaWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#FFF0F0F0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="27" ResizeBorderThickness="6" GlassFrameThickness="0"
                              CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="Outer" BorderBrush="{DynamicResource Rb.FrameBorder}" BorderThickness="1" Background="{DynamicResource Rb.Frame}">
                        <Grid>
                            <Border Background="{StaticResource GlassStreakBrush}" IsHitTestVisible="False"/>
                            <Border BorderBrush="#70FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Height="27" Panel.ZIndex="1">
                                    <StackPanel x:Name="TitleStack" Orientation="Horizontal" Margin="7,1,140,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image x:Name="TitleIconImg" Source="{DynamicResource TitleIcon}" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="12.5" Foreground="{DynamicResource Rb.FrameText}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="14" Opacity="1"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                    <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Left" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,6,0">
                                        <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Tag="{StaticResource CrLeft}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                                            <Path Style="{StaticResource GlyphPath}" Data="M0,0 H9 V3 H0 Z" Margin="0,6,0,0"/>
                                        </Button>
                                        <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                                            <Grid>
                                                <Path x:Name="GlyphMax" Style="{StaticResource GlyphPath}" Data="M0,0 H10 V8 H0 Z M2,3 H8 V6 H2 Z"/>
                                                <Path x:Name="GlyphRestore" Style="{StaticResource GlyphPath}" Visibility="Collapsed"
                                                      Data="M3,0 H11 V6 H9 V2.5 H3 Z M0,3.5 H8 V9.5 H0 Z M2,5.8 H6 V7.5 H2 Z"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                                            <Path Style="{StaticResource GlyphPath}"
                                                  Data="M0,1.2 L1.2,0 L4.6,3.3 L8,0 L9.2,1.2 L5.8,4.6 L9.2,8 L8,9.2 L4.6,5.8 L1.2,9.2 L0,8 L3.4,4.6 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="Client" Margin="7,0,7,7" BorderBrush="#FF56687E" BorderThickness="1"
                                        Background="{TemplateBinding Background}">
                                    <AdornerDecorator>
                                        <ContentPresenter/>
                                    </AdornerDecorator>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="TitleStack" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="TitleIconImg" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Outer" Property="Padding" Value="7,7,7,0"/>
                            <Setter TargetName="Client" Property="Margin" Value="0"/>
                            <Setter TargetName="GlyphMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="GlyphRestore" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BtnMax" Property="ToolTip" Value="Restore Down"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Outer" Property="Background" Value="{DynamicResource Rb.FrameInactive}"/>
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#FF7D8B9A"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMin" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnClose" Property="Tag" Value="{StaticResource CrBoth}"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="BtnMax" Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
