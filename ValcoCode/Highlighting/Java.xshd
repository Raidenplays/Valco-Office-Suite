<?xml version="1.0"?>
<SyntaxDefinition name="Java" extensions=".java" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#6b7380" />
  <Color name="String" foreground="#98c379" />
  <Color name="Number" foreground="#d19a66" />
  <Color name="Keyword" foreground="#c678dd" />
  <Color name="Control" foreground="#c678dd" />
  <Color name="Storage" foreground="#c678dd" />
  <Color name="Constant" foreground="#d19a66" />
  <Color name="Type" foreground="#e5c07b" />
  <Color name="Class" foreground="#e5c07b" />
  <Color name="Function" foreground="#61afef" />
  <Color name="Self" foreground="#e06c75" />
  <Color name="Annotation" foreground="#36c2b4" />
  <Color name="Operator" foreground="#56b6c2" />
  <Color name="Punct" foreground="#abb2bf" />

  <RuleSet ignoreCase="false">
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String" multiline="true"><Begin>"""</Begin><End>"""</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>
    <Span color="String"><Begin>"</Begin><End>"</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>
    <Span color="String"><Begin>'</Begin><End>'</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>

    <Rule color="Annotation">@\w+</Rule>

    <Keywords color="Control">
      <Word>if</Word><Word>else</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>switch</Word><Word>case</Word><Word>default</Word>
      <Word>break</Word><Word>continue</Word><Word>return</Word><Word>try</Word><Word>catch</Word><Word>finally</Word><Word>throw</Word>
      <Word>yield</Word><Word>assert</Word>
    </Keywords>
    <Keywords color="Storage">
      <Word>public</Word><Word>private</Word><Word>protected</Word><Word>static</Word><Word>final</Word><Word>abstract</Word>
      <Word>synchronized</Word><Word>volatile</Word><Word>transient</Word><Word>native</Word><Word>strictfp</Word><Word>sealed</Word>
      <Word>class</Word><Word>interface</Word><Word>enum</Word><Word>record</Word><Word>extends</Word><Word>implements</Word><Word>permits</Word>
      <Word>throws</Word><Word>var</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>import</Word><Word>package</Word><Word>new</Word><Word>instanceof</Word>
    </Keywords>
    <Keywords color="Self">
      <Word>this</Word><Word>super</Word>
    </Keywords>
    <Keywords color="Constant">
      <Word>true</Word><Word>false</Word><Word>null</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>int</Word><Word>long</Word><Word>short</Word><Word>byte</Word><Word>char</Word><Word>boolean</Word><Word>float</Word>
      <Word>double</Word><Word>void</Word>
    </Keywords>

    <Rule color="Function">\b[a-z_$][\w$]*(?=\s*\()</Rule>
    <Rule color="Class">\b[A-Z][\w$]*\b</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+[lL]?\b|\b0[bB][01_]+[lL]?\b|\b\d[\d_]*(\.[\d_]*)?([eE][+-]?\d+)?[fFdDlL]?\b|\.\d[\d_]*([eE][+-]?\d+)?[fFdD]?\b</Rule>
    <Rule color="Operator">[-+*/%=&lt;&gt;!&amp;|^~?:]+</Rule>
    <Rule color="Punct">[()\[\]{},.;]</Rule>
  </RuleSet>
</SyntaxDefinition>
