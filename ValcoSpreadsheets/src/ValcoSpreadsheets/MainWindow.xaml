<local:VistaWindow x:Class="ValcoSpreadsheets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ValcoSpreadsheets"
        xmlns:grid="clr-namespace:ValcoSpreadsheets.Grid"
        Title="Book1 - Valco Spreadsheets" Width="1180" Height="800" MinWidth="640" MinHeight="420" AllowDrop="True">
    <DockPanel x:Name="Root">
        <!-- ===================== Ribbon (built in MainWindow.Ribbon.cs) ===================== -->
        <Grid x:Name="RibbonHost" DockPanel.Dock="Top"/>

        <!-- ===================== Message bar (macros, read-only, kept-parts warnings) ===================== -->
        <Border x:Name="MessageBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFFFF6C9" BorderBrush="#FFE2C77A" BorderThickness="0,0,0,1" Padding="8,3">
            <DockPanel>
                <Button x:Name="MessageBarClose" DockPanel.Dock="Right" Style="{StaticResource FmtButton}" ToolTip="Close the Message Bar" Click="MessageBarClose_Click">
                    <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#FF5A4A20" StrokeThickness="1.4"/>
                </Button>
                <Button x:Name="MessageBarButton" DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Margin="6,0,8,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="MessageBarIcon" Source="{StaticResource IconWarning}" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock x:Name="MessageBarTitle" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MessageBarText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Formula bar ===================== -->
        <Border x:Name="FormulaBar" DockPanel.Dock="Top" Background="{DynamicResource Rb.TabStrip}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,0,1" Padding="3,3,3,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NameCol" Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="NameBox" IsEditable="True" Height="21" FontSize="12" VerticalContentAlignment="Center" ToolTip="Name Box" IsTextSearchEnabled="False"/>
                <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" ToolTip="Drag to resize the Name Box"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,3,0">
                    <Button x:Name="BtnFxCancel" Style="{StaticResource FmtButton}" Height="21" MinWidth="22" ToolTip="Cancel" Click="FxCancel_Click" IsEnabled="False">
                        <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="#FFC0281C" StrokeThickness="1.8"/>
                    </Button>
                    <Button x:Name="BtnFxEnter" Style="{StaticResource FmtButton}" Height="21" MinWidth="22" ToolTip="Enter" Click="FxEnter_Click" IsEnabled="False">
                        <Path Data="M0,4.5 L3,7.5 L9,0.5" Stroke="#FF2E9A1C" StrokeThickness="1.8"/>
                    </Button>
                    <Button x:Name="BtnFx" Style="{StaticResource FmtButton}" Height="21" MinWidth="24" ToolTip="Insert Function" Click="InsertFunction_Click">
                        <TextBlock Text="fx" FontFamily="Times New Roman" FontStyle="Italic" FontSize="14" Margin="0,-3,0,0" Foreground="#FF1E3957"/>
                    </Button>
                </StackPanel>
                <Border Grid.Column="3" BorderBrush="#FFA3B7D3" BorderThickness="1" Background="White">
                    <DockPanel>
                        <Button x:Name="BtnFxExpand" DockPanel.Dock="Right" Style="{StaticResource FmtButton}" Height="19" MinWidth="16" Width="16" Padding="0" ToolTip="Expand Formula Bar (Ctrl+Shift+U)" Click="FxExpand_Click">
                            <Path x:Name="FxExpandGlyph" Data="M0,0 L6,0 L3,3.5 Z" Fill="#FF3B4A5C"/>
                        </Button>
                        <TextBox x:Name="FormulaBox" BorderThickness="0" FontSize="12" Padding="2,1" VerticalContentAlignment="Center" AcceptsReturn="False"
                                 FontFamily="Calibri" Height="19" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource Rb.Status}" BorderBrush="#FF8DA6C7" BorderThickness="0,1,0,0" Height="23">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="StatAvg" Foreground="{DynamicResource Rb.StatusText}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="StatCount" Foreground="{DynamicResource Rb.StatusText}" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock x:Name="StatSum" Foreground="{DynamicResource Rb.StatusText}" VerticalAlignment="Center" Margin="8,0,12,0"/>
                    <Border Style="{StaticResource StatusSep}"/>
                    <StackPanel x:Name="ViewButtons" Orientation="Horizontal" Margin="4,0,4,0"/>
                    <Border Style="{StaticResource StatusSep}"/>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomDialog_Click" ToolTip="Zoom level" Margin="4,0,0,0">
                        <TextBlock x:Name="ZoomText" Text="100%" Width="38" TextAlignment="Center" Foreground="{DynamicResource Rb.StatusText}"/>
                    </Button>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomOut_Click" ToolTip="Zoom Out"><Path Data="M0,0 H8 V2 H0 Z" Fill="{DynamicResource Rb.StatusText}"/></Button>
                    <Slider x:Name="ZoomSlider" Width="110" Minimum="10" Maximum="400" Value="100" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" IsMoveToPointEnabled="True"/>
                    <Button Style="{StaticResource StatusButton}" Click="ZoomIn_Click" ToolTip="Zoom In" Margin="0,0,6,0"><Path Data="M3,0 H5 V3 H8 V5 H5 V8 H3 V5 H0 V3 H3 Z" Fill="{DynamicResource Rb.StatusText}"/></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Rb.StatusText}">
                    <TextBlock x:Name="ModeText" Text="Ready" VerticalAlignment="Center" Margin="8,0" MinWidth="44" Foreground="{DynamicResource Rb.StatusText}"/>
                    <Border Style="{StaticResource StatusSep}"/>
                    <TextBlock x:Name="StatusMsg" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource Rb.StatusText}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Sheet tabs + horizontal scroll bar ===================== -->
        <Border x:Name="TabBar" DockPanel.Dock="Bottom" Height="20" Background="{DynamicResource Rb.TabStrip}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,1,0,0">
            <Grid x:Name="TabBarGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="TabsCol" Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="TabNav" Orientation="Horizontal" Margin="2,0,2,0"/>
                <ScrollViewer x:Name="TabScroller" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" VerticalAlignment="Top"/>
                </ScrollViewer>
                <GridSplitter Grid.Column="2" Width="5" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="#FFB7C8DE" Cursor="SizeWE"/>
                <ContentControl x:Name="HScrollHost" Grid.Column="3" VerticalAlignment="Center" Focusable="False"/>
            </Grid>
        </Border>

        <!-- ===================== Worksheet ===================== -->
        <grid:SheetView x:Name="Sheet"/>
    </DockPanel>
</local:VistaWindow>
