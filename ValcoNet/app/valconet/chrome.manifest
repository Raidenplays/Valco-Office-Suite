content  valconet  content/
skin     valconet  classic/1.0  skin/
resource valconet  modules/
resource valconet-l10n localization/

# Branding: ValcoNet's name and icons replace the engine's wherever Gecko asks for them.
override chrome://branding/locale/brand.properties chrome://valconet/content/branding/brand.properties
override chrome://branding/content/icon16.png chrome://valconet/content/branding/icon16.png
override chrome://branding/content/icon32.png chrome://valconet/content/branding/icon32.png
override chrome://branding/content/icon48.png chrome://valconet/content/branding/icon48.png
override chrome://branding/content/icon64.png chrome://valconet/content/branding/icon64.png
override chrome://branding/content/icon128.png chrome://valconet/content/branding/icon128.png
override chrome://branding/content/about-logo.png chrome://valconet/content/branding/about-logo.png
override chrome://branding/content/about-logo@2x.png chrome://valconet/content/branding/about-logo.png
override chrome://branding/content/about-logo.svg chrome://valconet/content/branding/about-logo.svg
override chrome://branding/content/about-logo-private.png chrome://valconet/content/branding/about-logo.png
override chrome://branding/content/about-logo-private@2x.png chrome://valconet/content/branding/about-logo.png
override chrome://branding/content/document_pdf.svg chrome://valconet/content/branding/about-logo.svg

# Error pages: IE-style artwork instead of the engine's mascot.
override chrome://global/skin/illustrations/kit-concerned.svg chrome://valconet/skin/icons/illu-error.svg
override chrome://global/skin/illustrations/kit-in-circle.svg chrome://valconet/skin/icons/illu-error.svg
override chrome://global/skin/illustrations/kit-happy.svg chrome://valconet/skin/icons/valconet.svg
override chrome://global/skin/illustrations/no-connection.svg chrome://valconet/skin/icons/illu-error.svg
override chrome://global/skin/illustrations/error-malformed-url.svg chrome://valconet/skin/icons/illu-error.svg
override chrome://global/skin/illustrations/security-error.svg chrome://valconet/skin/icons/illu-security.svg
