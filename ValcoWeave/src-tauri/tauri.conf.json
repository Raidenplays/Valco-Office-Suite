{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valco Weave",
  "version": "0.5.0",
  "identifier": "com.itsraiden.weavecraft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Valco Weave",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual web editor",
    "longDescription": "Valco Weave is a free, open-source visual web editor in the spirit of Dreamweaver: Code, Split, Design and Live views, a CSS Designer, and FTP publishing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "web"
      }
    },
    "publisher": "ItsRaiden",
    "copyright": "© 2026 ItsRaiden"
  }
}