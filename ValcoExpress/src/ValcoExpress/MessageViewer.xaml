<UserControl x:Class="ValcoExpress.MessageViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border x:Name="HeaderBand" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource PreviewHeaderBrush}"
                BorderBrush="#FFA9BBD1" BorderThickness="0,0,0,1" Padding="9,5,9,6">
            <StackPanel x:Name="HeaderLines"/>
        </Border>
        <Border x:Name="InfoBar" Grid.Row="1" Visibility="Collapsed" Background="#FFFFFFE1" BorderBrush="#FFC7B677"
                BorderThickness="0,0,0,1" Padding="7,4" Cursor="Hand" MouseLeftButtonUp="InfoBar_Click"
                ToolTip="Click to show pictures and other external content in this message">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource IconWarning}" Width="16" Height="16"/>
                <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                           Text="Some pictures have been blocked so the sender can't tell you opened this message. Click here to download pictures."/>
            </StackPanel>
        </Border>
        <Border x:Name="AttachBar" Grid.Row="2" Visibility="Collapsed" Background="White" BorderBrush="#FFD5DFEA"
                BorderThickness="0,0,0,1" Padding="6,3">
            <WrapPanel x:Name="AttachPanel"/>
        </Border>
        <Grid Grid.Row="3" Background="White">
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed"/>
            <TextBox x:Name="Fallback" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto" Padding="8" FontFamily="Calibri, Segoe UI" FontSize="14.5"/>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20,28,20,0"
                       Foreground="#FF6D6D6D" TextAlignment="Center" TextWrapping="Wrap" Text="There is no message selected."/>
        </Grid>
    </Grid>
</UserControl>
