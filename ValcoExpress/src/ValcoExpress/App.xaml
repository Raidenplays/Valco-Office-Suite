<Application x:Class="ValcoExpress.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ValcoExpress">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Vista.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:IconKeyConverter x:Key="IconConv"/>
            <BooleanToVisibilityConverter x:Key="BoolVis"/>

            <HierarchicalDataTemplate x:Key="FolderTemplate" DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1,2,1">
                    <Image Source="{Binding IconKey, Converter={StaticResource IconConv}}" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock x:Name="N" Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding UnreadText}" Foreground="#FF0033CC" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status, StringFormat='({0})'}" Foreground="#FF808080" FontStyle="Italic" Margin="4,0,0,0"
                               VerticalAlignment="Center" Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                        <Setter TargetName="N" Property="FontWeight" Value="Bold"/>
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <Style x:Key="FolderItemStyle" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                <Setter Property="Padding" Value="2,0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
