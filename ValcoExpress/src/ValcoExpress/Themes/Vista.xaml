<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SuiteIcons.xaml"/>
        <ResourceDictionary Source="/PresentationFramework.Aero;component/themes/Aero.NormalColor.xaml"/>
        <ResourceDictionary Source="Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== Glass frame ===================== -->
    <LinearGradientBrush x:Key="GlassFrameBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,64">
        <GradientStop Color="#FFC4D7EC" Offset="0"/>
        <GradientStop Color="#FFA7C0DD" Offset="0.42"/>
        <GradientStop Color="#FF8EABCD" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFrameInactiveBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,64">
        <GradientStop Color="#FFE0E8F1" Offset="0"/>
        <GradientStop Color="#FFCFDAE6" Offset="0.42"/>
        <GradientStop Color="#FFC3D0DE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStreakBrush" StartPoint="0,0" EndPoint="1,0.35">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.18"/>
        <GradientStop Color="#38FFFFFF" Offset="0.215"/>
        <GradientStop Color="#14FFFFFF" Offset="0.26"/>
        <GradientStop Color="#00FFFFFF" Offset="0.29"/>
        <GradientStop Color="#00FFFFFF" Offset="0.52"/>
        <GradientStop Color="#2CFFFFFF" Offset="0.555"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        <GradientStop Color="#00FFFFFF" Offset="0.78"/>
        <GradientStop Color="#22FFFFFF" Offset="0.805"/>
        <GradientStop Color="#00FFFFFF" Offset="0.85"/>
    </LinearGradientBrush>

    <!-- caption buttons -->
    <LinearGradientBrush x:Key="CapNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D8EAF2FB" Offset="0"/>
        <GradientStop Color="#A8C4D6EA" Offset="0.45"/>
        <GradientStop Color="#9091AACB" Offset="0.5"/>
        <GradientStop Color="#B0B7CDE5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFEAF8FF" Offset="0"/>
        <GradientStop Color="#FFB4E2FB" Offset="0.45"/>
        <GradientStop Color="#FF5FC0EF" Offset="0.5"/>
        <GradientStop Color="#FF9CEAFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF9CC6E6" Offset="0"/>
        <GradientStop Color="#FF5B97C8" Offset="0.45"/>
        <GradientStop Color="#FF2A6BA3" Offset="0.5"/>
        <GradientStop Color="#FF4C98CF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapCloseNormal" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE9AE9F" Offset="0"/>
        <GradientStop Color="#FFDA8571" Offset="0.45"/>
        <GradientStop Color="#FFC34A30" Offset="0.5"/>
        <GradientStop Color="#FFD9785B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapCloseHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFC9B9" Offset="0"/>
        <GradientStop Color="#FFF48C70" Offset="0.45"/>
        <GradientStop Color="#FFE5401B" Offset="0.5"/>
        <GradientStop Color="#FFFBA27B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CapClosePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFCA7C69" Offset="0"/>
        <GradientStop Color="#FFB14A31" Offset="0.45"/>
        <GradientStop Color="#FF8E2310" Offset="0.5"/>
        <GradientStop Color="#FFB2502D" Offset="1"/>
    </LinearGradientBrush>
    <CornerRadius x:Key="CrLeft">0,0,0,4</CornerRadius>
    <CornerRadius x:Key="CrNone">0</CornerRadius>
    <CornerRadius x:Key="CrRight">0,0,4,0</CornerRadius>
    <CornerRadius x:Key="CrBoth">0,0,4,4</CornerRadius>

    <Style x:Key="CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Background" Value="{StaticResource CapNormal}"/>
        <Setter Property="Tag" Value="{StaticResource CrNone}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="#FF34465C" BorderThickness="1,0,1,1"
                            CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid>
                            <Border BorderBrush="#77FFFFFF" BorderThickness="1,0,1,1"
                                    CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CapHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource CapPressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="43"/>
        <Setter Property="Background" Value="{StaticResource CapCloseNormal}"/>
        <Setter Property="Tag" Value="{StaticResource CrRight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CapCloseHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource CapClosePressed}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GlyphPath" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="White"/>
        <Setter Property="Stroke" Value="#FF1F2C3B"/>
        <Setter Property="StrokeThickness" Value="0.9"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== Vista window ===================== -->
    <Style x:Key="VistaWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#FFF0F0F0"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="27" ResizeBorderThickness="6" GlassFrameThickness="0"
                              CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="Outer" BorderBrush="#FF26323F" BorderThickness="1" Background="{StaticResource GlassFrameBrush}">
                        <Grid>
                            <Border Background="{StaticResource GlassStreakBrush}" IsHitTestVisible="False"/>
                            <Border BorderBrush="#70FFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Height="27" Panel.ZIndex="1">
                                    <StackPanel x:Name="TitleStack" Orientation="Horizontal" Margin="7,1,140,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image x:Name="TitleIconImg" Source="{DynamicResource TitleIcon}" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="12.5" Foreground="#FF0B0F14"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="14" Opacity="1"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </StackPanel>
                                    <ContentPresenter Content="{TemplateBinding Tag}" HorizontalAlignment="Left" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,6,0">
                                        <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" Tag="{StaticResource CrLeft}"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
                                            <Path Style="{StaticResource GlyphPath}" Data="M0,0 H9 V3 H0 Z" Margin="0,6,0,0"/>
                                        </Button>
                                        <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
                                            <Grid>
                                                <Path x:Name="GlyphMax" Style="{StaticResource GlyphPath}" Data="M0,0 H10 V8 H0 Z M2,3 H8 V6 H2 Z"/>
                                                <Path x:Name="GlyphRestore" Style="{StaticResource GlyphPath}" Visibility="Collapsed"
                                                      Data="M3,0 H11 V6 H9 V2.5 H3 Z M0,3.5 H8 V9.5 H0 Z M2,5.8 H6 V7.5 H2 Z"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButton}"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                                WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
                                            <Path Style="{StaticResource GlyphPath}"
                                                  Data="M0,1.2 L1.2,0 L4.6,3.3 L8,0 L9.2,1.2 L5.8,4.6 L9.2,8 L8,9.2 L4.6,5.8 L1.2,9.2 L0,8 L3.4,4.6 Z"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="Client" Margin="7,0,7,7" BorderBrush="#FF56687E" BorderThickness="1"
                                        Background="{TemplateBinding Background}">
                                    <AdornerDecorator>
                                        <ContentPresenter/>
                                    </AdornerDecorator>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="TitleStack" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="TitleIconImg" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Outer" Property="Padding" Value="7,7,7,0"/>
                            <Setter TargetName="Client" Property="Margin" Value="0"/>
                            <Setter TargetName="GlyphMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="GlyphRestore" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="BtnMax" Property="ToolTip" Value="Restore Down"/>
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="Outer" Property="Background" Value="{StaticResource GlassFrameInactiveBrush}"/>
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#FF7D8B9A"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="BtnMin" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnMax" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="BtnClose" Property="Tag" Value="{StaticResource CrBoth}"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="BtnMax" Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Menu bar ===================== -->
    <LinearGradientBrush x:Key="MenuBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF7F9FC" Offset="0"/>
        <GradientStop Color="#FFE5EBF3" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="VistaMenuBar" TargetType="{x:Type Menu}" BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="Background" Value="{DynamicResource MenuBarBrush}"/>
        <Setter Property="BorderBrush" Value="#FFB6C3D3"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- ===================== Command bar (dark Vista toolbar) ===================== -->
    <LinearGradientBrush x:Key="CommandBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6E90A9" Offset="0"/>
        <GradientStop Color="#FF46677F" Offset="0.48"/>
        <GradientStop Color="#FF2A4A60" Offset="0.5"/>
        <GradientStop Color="#FF3E6178" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CmdHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.48"/>
        <GradientStop Color="#10FFFFFF" Offset="0.5"/>
        <GradientStop Color="#35BFF4FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CmdPressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55000000" Offset="0"/>
        <GradientStop Color="#30000000" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="CommandBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CommandBarBrush}"/>
        <Setter Property="BorderBrush" Value="#FF1B2E3C"/>
        <Setter Property="BorderThickness" Value="0,1,0,1"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="CmdButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Padding" Value="6,3,7,3"/>
        <Setter Property="Margin" Value="0,0,1,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="B" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="#FF9FE6FF" ShadowDepth="0" BlurRadius="0" Opacity="0"/>
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#A0E8F6FF"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CmdHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CmdPressed}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#80FFFFFF"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="B" Property="Background" Value="{StaticResource CmdPressed}"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#80FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CmdLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CmdSeparator" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="BorderBrush" Value="#55000000"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
    </Style>

    <!-- light toolbar (formatting bar) -->
    <LinearGradientBrush x:Key="LightBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFDFEFF" Offset="0"/>
        <GradientStop Color="#FFE7EDF5" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE3EFFD" Offset="0"/>
        <GradientStop Color="#FFC4DDFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SelInactiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6F6F6" Offset="0"/>
        <GradientStop Color="#FFE3E3E3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFAFCFE" Offset="0"/>
        <GradientStop Color="#FFE9F2FD" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="FmtButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="Margin" Value="0,0,1,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="B" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#FFA7CDF0"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#FF7DA2CE"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SelBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#FF6D93C4"/>
                            <Setter TargetName="B" Property="Background" Value="#FFC2DAF5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Panes ===================== -->
    <LinearGradientBrush x:Key="PreviewHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFBFCFE" Offset="0"/>
        <GradientStop Color="#FFE1E9F4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatusBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF3F6FA" Offset="0"/>
        <GradientStop Color="#FFDAE3EE" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PaneHeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFE8EEF6" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFDCE4EE"/>
    <SolidColorBrush x:Key="StatusText" Color="#FF15428B"/>
    <SolidColorBrush x:Key="PaneHeaderText" Color="#FF1E395B"/>
    <SolidColorBrush x:Key="ChromeLine" Color="#FFAFBFD3"/>
    <Style x:Key="VSplitter" TargetType="{x:Type GridSplitter}">
        <Setter Property="Width" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="HSplitter" TargetType="{x:Type GridSplitter}">
        <Setter Property="Height" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="ResizeDirection" Value="Rows"/>
        <Setter Property="Background" Value="{DynamicResource SplitterBrush}"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- Vista selection for message rows -->
    <Style x:Key="VistaListViewItem" TargetType="{x:Type ListViewItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Padding" Value="0,1"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="B" CornerRadius="2" BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#FFB8D6FB"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="B" Property="BorderBrush" Value="#FF84ACDD"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SelBrush}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="B" Property="BorderBrush" Value="#FFD9D9D9"/>
                            <Setter TargetName="B" Property="Background" Value="{StaticResource SelInactiveBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search box -->
    <Style x:Key="SearchBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="23"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="4,0,22,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="B" Background="White" BorderBrush="#FF3E5568" BorderThickness="1" CornerRadius="2">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Hint" Text="Search" Foreground="#FF8A949E" FontStyle="Italic"
                                       Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <Image Source="{StaticResource IconFind}" Width="15" Height="15" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="B" Property="BorderBrush" Value="#FF3D7BAD"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vista dialog button strip -->
    <Style x:Key="DialogStrip" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#FFF0F0F0"/>
        <Setter Property="BorderBrush" Value="#FFDFDFDF"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="10,9"/>
    </Style>
    <Style x:Key="DialogButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Height" Value="23"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>
</ResourceDictionary>
