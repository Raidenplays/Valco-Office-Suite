<local:VistaWindow x:Class="ValcoExpress.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ValcoExpress"
        Title="Inbox - Valco Express" Width="1040" Height="720" MinWidth="640" MinHeight="420">
    <local:VistaWindow.Resources>
        <Style x:Key="ColImg" TargetType="{x:Type Image}">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MsgItem" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource VistaListViewItem}">
            <EventSetter Event="MouseDoubleClick" Handler="Message_DoubleClick"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRead}" Value="False">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                    <Setter Property="Foreground" Value="#FF9A1206"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:VistaWindow.Resources>

    <DockPanel>
        <!-- Ribbon, Valco button and Quick Access Toolbar (MainWindow.Ribbon.cs). The classic menu is kept hidden for its command state. -->
        <Grid x:Name="RibbonHost" DockPanel.Dock="Top"/>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Style="{StaticResource VistaMenuBar}" Visibility="Collapsed">
            <MenuItem Header="_File" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_New">
                    <MenuItem Header="_Mail Message" InputGestureText="Ctrl+N" Click="NewMail_Click"/>
                    <MenuItem Header="_Folder..." InputGestureText="Ctrl+Shift+E" Click="NewFolder_Click"/>
                    <MenuItem Header="_Contact..." Click="NewContact_Click"/>
                </MenuItem>
                <MenuItem x:Name="MiOpen" Header="_Open" InputGestureText="Enter" Click="Open_Click"/>
                <MenuItem Header="Open Message _File..." Click="OpenFile_Click"/>
                <MenuItem x:Name="MiSaveAs" Header="Save _As..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Import Messages from Folder..." Click="Import_Click"/>
                <MenuItem x:Name="MiExport" Header="_Export Selected Messages..." Click="Export_Click"/>
                <Separator/>
                <MenuItem x:Name="MiPrint" Header="_Print..." InputGestureText="Ctrl+P" Click="Print_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" SubmenuOpened="Menu_Opened">
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                <Separator/>
                <MenuItem x:Name="MiDelete" Header="_Delete" InputGestureText="Del" Click="Delete_Click"/>
                <MenuItem x:Name="MiMove" Header="_Move to Folder..." InputGestureText="Ctrl+Shift+V" Click="MoveTo_Click"/>
                <MenuItem x:Name="MiCopy" Header="Cop_y to Folder..." Click="CopyTo_Click"/>
                <Separator/>
                <MenuItem x:Name="MiRead" Header="Mar_k as Read" InputGestureText="Ctrl+Q" Click="MarkRead_Click"/>
                <MenuItem x:Name="MiUnread" Header="Mark as U_nread" InputGestureText="Ctrl+U" Click="MarkUnread_Click"/>
                <MenuItem Header="Mark All Rea_d" InputGestureText="Ctrl+Shift+A" Click="MarkAllRead_Click"/>
                <Separator/>
                <MenuItem Header="_Find Message..." InputGestureText="Ctrl+E" Click="Find_Click"/>
                <Separator/>
                <MenuItem Header="Empty 'Deleted _Items' Folder" Click="EmptyDeleted_Click"/>
                <MenuItem Header="Empty 'Junk E-_mail' Folder" Click="EmptyJunk_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Layout">
                    <MenuItem x:Name="MiFolders" Header="_Folder List" IsCheckable="True" Click="Layout_Click"/>
                    <MenuItem x:Name="MiPreview" Header="_Preview Pane" IsCheckable="True" Click="Layout_Click"/>
                    <MenuItem x:Name="MiToolbar" Header="_Toolbar" IsCheckable="True" Click="Layout_Click"/>
                    <MenuItem x:Name="MiStatus" Header="_Status Bar" IsCheckable="True" Click="Layout_Click"/>
                </MenuItem>
                <MenuItem Header="_Current View">
                    <MenuItem x:Name="MiShowAll" Header="Show _All Messages" IsCheckable="True" Click="ShowAll_Click"/>
                    <MenuItem x:Name="MiHideRead" Header="_Hide Read Messages" IsCheckable="True" Click="HideRead_Click"/>
                </MenuItem>
                <MenuItem Header="_Sort By">
                    <MenuItem x:Name="MiSortFrom" Header="_From" IsCheckable="True" Tag="Who" Click="SortMenu_Click"/>
                    <MenuItem x:Name="MiSortSubject" Header="_Subject" IsCheckable="True" Tag="Subject" Click="SortMenu_Click"/>
                    <MenuItem x:Name="MiSortDate" Header="_Received" IsCheckable="True" Tag="Date" Click="SortMenu_Click"/>
                    <MenuItem x:Name="MiSortSize" Header="Si_ze" IsCheckable="True" Tag="Size" Click="SortMenu_Click"/>
                    <MenuItem x:Name="MiSortFlag" Header="F_lag" IsCheckable="True" Tag="IsFlagged" Click="SortMenu_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MiSortAsc" Header="Sort _Ascending" IsCheckable="True" Click="SortAsc_Click"/>
                    <MenuItem x:Name="MiSortDesc" Header="Sort _Descending" IsCheckable="True" Click="SortDesc_Click"/>
                </MenuItem>
                <MenuItem Header="Color _Scheme">
                    <MenuItem x:Name="MiSchemeBlue" Header="_Blue" IsCheckable="True" Tag="Blue" Click="Scheme_Click"/>
                    <MenuItem x:Name="MiSchemeSilver" Header="_Silver" IsCheckable="True" Tag="Silver" Click="Scheme_Click"/>
                    <MenuItem x:Name="MiSchemeBlack" Header="Blac_k" IsCheckable="True" Tag="Black" Click="Scheme_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Refresh" InputGestureText="F5" Click="Refresh_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Send and Receive All" InputGestureText="Ctrl+M" Click="SendReceive_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconSendReceive}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Contacts" InputGestureText="Ctrl+Shift+C" Click="Contacts_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconContacts}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MiAddSender" Header="Add Sender to Contacts" Click="AddSender_Click"/>
                <Separator/>
                <MenuItem Header="_Accounts..." Click="Accounts_Click"/>
                <MenuItem Header="_Options..." Click="Options_Click"/>
            </MenuItem>
            <MenuItem Header="_Message" SubmenuOpened="Menu_Opened">
                <MenuItem Header="_New Message" InputGestureText="Ctrl+N" Click="NewMail_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconCreateMail}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MiReply" Header="_Reply to Sender" InputGestureText="Ctrl+R" Click="Reply_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconReply}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MiReplyAll" Header="Reply to _All" InputGestureText="Ctrl+Shift+R" Click="ReplyAll_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconReplyAll}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MiForward" Header="_Forward" InputGestureText="Ctrl+F" Click="Forward_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconForward}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MiForwardAtt" Header="Forward as Attach_ment" Click="ForwardAtt_Click"/>
                <Separator/>
                <MenuItem x:Name="MiFlag" Header="Fla_g Message" Click="Flag_Click">
                    <MenuItem.Icon><Image Source="{StaticResource IconFlag}" Width="16" Height="16"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="MiJunkMenu" Header="_Junk E-mail">
                    <MenuItem Header="Mark as _Junk" Click="MarkJunk_Click"/>
                    <MenuItem Header="Mark as _Not Junk" Click="NotJunk_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard Shortcuts" Click="Shortcuts_Click"/>
                <Separator/>
                <MenuItem Header="_About Valco Express" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Search bar (View > Search Bar) -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Background="{DynamicResource LightBarBrush}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="260" Style="{StaticResource SearchBox}"
                         VerticalAlignment="Center" Margin="8,0,0,0" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown"/>
                <TextBlock x:Name="FolderTitle" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource PaneHeaderText}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,1,0,0" Height="23">
            <DockPanel Margin="6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Background="#FFB2C0D2" Margin="0,2,8,2"/>
                    <Image x:Name="StatusIcon" Source="{StaticResource IconAccount}" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusRight" Text="Working Online" VerticalAlignment="Center" Foreground="{DynamicResource StatusText}"/>
                </StackPanel>
                <TextBlock x:Name="StatusLeft" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusText}"/>
            </DockPanel>
        </Border>

        <Grid x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderCol" Width="210" MinWidth="0"/>
                <ColumnDefinition x:Name="SplitCol" Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="FolderPane" Grid.Column="0" Background="White">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PaneHeaderBrush}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,0,1" Height="24">
                    <DockPanel Margin="6,0,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FmtButton}" Height="18" MinWidth="18" Padding="0" Click="ToggleFolders_Click" ToolTip="Close the folder list">
                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#FF4A5868" StrokeThickness="1.3"/>
                        </Button>
                        <TextBlock Text="Folders" VerticalAlignment="Center" Foreground="{DynamicResource PaneHeaderText}"/>
                    </DockPanel>
                </Border>
                <TreeView x:Name="FolderTree" BorderThickness="0" Padding="2,4,0,0" AllowDrop="True"
                          ItemTemplate="{StaticResource FolderTemplate}" ItemContainerStyle="{StaticResource FolderItemStyle}"
                          SelectedItemChanged="FolderTree_SelectedItemChanged"
                          DragOver="FolderTree_DragOver" Drop="FolderTree_Drop"
                          PreviewMouseRightButtonDown="FolderTree_RightDown"/>
            </DockPanel>

            <GridSplitter x:Name="FolderSplitter" Grid.Column="1" Style="{StaticResource VSplitter}"/>

            <Grid Grid.Column="2" x:Name="RightGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="80"/>
                    <RowDefinition x:Name="SplitRow" Height="Auto"/>
                    <RowDefinition x:Name="PreviewRowDef" Height="320" MinHeight="0"/>
                </Grid.RowDefinitions>
                <ListView x:Name="MessageList" Grid.Row="0" BorderThickness="0" ItemContainerStyle="{StaticResource MsgItem}"
                          SelectionMode="Extended" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="MessageList_SelectionChanged"
                          PreviewMouseLeftButtonDown="MessageList_MouseDown" PreviewMouseMove="MessageList_MouseMove"
                          ContextMenuOpening="MessageList_ContextMenuOpening"
                          GridViewColumnHeader.Click="Header_Click">
                    <ListView.ContextMenu>
                        <ContextMenu x:Name="MessageMenu">
                            <MenuItem Header="_Open" FontWeight="Bold" Click="Open_Click"/>
                            <MenuItem Header="_Print" Click="Print_Click"/>
                            <Separator/>
                            <MenuItem Header="Reply to _Sender" Click="Reply_Click"><MenuItem.Icon><Image Source="{StaticResource IconReply}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Reply to _All" Click="ReplyAll_Click"><MenuItem.Icon><Image Source="{StaticResource IconReplyAll}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="_Forward" Click="Forward_Click"><MenuItem.Icon><Image Source="{StaticResource IconForward}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Forward as Attach_ment" Click="ForwardAtt_Click"/>
                            <Separator/>
                            <MenuItem Header="Mar_k as Read" Click="MarkRead_Click"/>
                            <MenuItem Header="Mark as U_nread" Click="MarkUnread_Click"/>
                            <MenuItem x:Name="CtxFlag" Header="Fla_g Message" Click="Flag_Click"><MenuItem.Icon><Image Source="{StaticResource IconFlag}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="_Move to Folder..." Click="MoveTo_Click"/>
                            <MenuItem Header="Cop_y to Folder..." Click="CopyTo_Click"/>
                            <MenuItem Header="_Delete" Click="Delete_Click"><MenuItem.Icon><Image Source="{StaticResource IconDelete}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="Junk _E-mail">
                                <MenuItem Header="Mark as _Junk" Click="MarkJunk_Click"/>
                                <MenuItem Header="Mark as _Not Junk" Click="NotJunk_Click"/>
                            </MenuItem>
                            <MenuItem Header="Add Sender to _Contacts" Click="AddSender_Click"><MenuItem.Icon><Image Source="{StaticResource IconAddContact}" Width="16" Height="16"/></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Save _As..." Click="SaveAs_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView AllowsColumnReorder="True">
                            <GridViewColumn x:Name="ColPriority" Width="24">
                                <GridViewColumn.Header><TextBlock Text="!" FontWeight="Bold" Tag="Priority" ToolTip="Priority"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Image x:Name="Hi" Source="{StaticResource IconPriorityHigh}" Style="{StaticResource ColImg}" Visibility="Collapsed"/>
                                            <Image x:Name="Lo" Source="{StaticResource IconPriorityLow}" Style="{StaticResource ColImg}" Visibility="Collapsed"/>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHighPriority}" Value="True"><Setter TargetName="Hi" Property="Visibility" Value="Visible"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsLowPriority}" Value="True"><Setter TargetName="Lo" Property="Visibility" Value="Visible"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="24">
                                <GridViewColumn.Header><Image Source="{StaticResource IconAttach}" Width="13" Height="13" Tag="HasAttachments" ToolTip="Attachment"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{StaticResource IconAttach}" Style="{StaticResource ColImg}"
                                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="24">
                                <GridViewColumn.Header><Image Source="{StaticResource IconFlag}" Width="13" Height="13" Tag="IsFlagged" ToolTip="Flag status"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Width="18" Height="16" MouseLeftButtonUp="FlagCell_Click" ToolTip="Click to flag or unflag">
                                            <Image Source="{StaticResource IconFlag}" Style="{StaticResource ColImg}"
                                                   Visibility="{Binding IsFlagged, Converter={StaticResource BoolVis}}"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColFrom" Width="210">
                                <GridViewColumn.Header><TextBlock x:Name="FromHeader" Text="From" Tag="Who"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding EnvelopeIcon, Converter={StaticResource IconConv}}" Width="16" Height="16" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Who}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColSubject" Width="360">
                                <GridViewColumn.Header><TextBlock Text="Subject" Tag="Subject"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColDate" Width="150">
                                <GridViewColumn.Header><TextBlock x:Name="DateHeader" Text="Received" Tag="Date"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding DateDisplay}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="70">
                                <GridViewColumn.Header><TextBlock Text="Size" Tag="Size"/></GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="ListEmpty" Grid.Row="0" Margin="0,48,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Foreground="#FF6D6D6D" Text="There are no items in this view." IsHitTestVisible="False" Visibility="Collapsed"/>
                <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Style="{StaticResource HSplitter}"/>
                <local:MessageViewer x:Name="Viewer" Grid.Row="2"/>
            </Grid>
        </Grid>
    </DockPanel>
</local:VistaWindow>
