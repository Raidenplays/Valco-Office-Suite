<local:VistaWindow x:Class="ValcoExpress.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ValcoExpress"
        Title="New Message" Width="800" Height="640" MinWidth="520" MinHeight="380" AllowDrop="True"
        WindowStartupLocation="CenterOwner">
    <local:VistaWindow.Resources>
        <Style TargetType="{x:Type Path}" x:Key="Glyph">
            <Setter Property="Stroke" Value="#FF1E2A36"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="12"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </local:VistaWindow.Resources>
    <DockPanel>
        <Grid x:Name="RibbonHost" DockPanel.Dock="Top"/>
        <Menu DockPanel.Dock="Top" Style="{StaticResource VistaMenuBar}" Visibility="Collapsed">
            <MenuItem Header="_File">
                <MenuItem Header="_Send Message" InputGestureText="Alt+S" Click="Send_Click"/>
                <MenuItem Header="Sa_ve" InputGestureText="Ctrl+S" Click="Save_Click"/>
                <MenuItem Header="Save _As..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Close" Click="CloseMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="ApplicationCommands.Undo"/>
                <MenuItem Header="_Redo" Command="ApplicationCommands.Redo"/>
                <Separator/>
                <MenuItem Header="Cu_t" Command="ApplicationCommands.Cut"/>
                <MenuItem Header="_Copy" Command="ApplicationCommands.Copy"/>
                <MenuItem Header="_Paste" Command="ApplicationCommands.Paste"/>
                <Separator/>
                <MenuItem Header="Select _All" Command="ApplicationCommands.SelectAll"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="AllHeadersMenu" Header="_All Headers" IsCheckable="True" Click="AllHeaders_Click"/>
            </MenuItem>
            <MenuItem Header="_Insert">
                <MenuItem Header="File _Attachment..." Click="Attach_Click"/>
                <MenuItem Header="_Hyperlink..." Click="Link_Click"/>
                <MenuItem Header="Horizontal _Line" Click="Rule_Click"/>
            </MenuItem>
            <MenuItem Header="F_ormat">
                <MenuItem Header="_Bold" InputGestureText="Ctrl+B" Click="Bold_Click"/>
                <MenuItem Header="_Italic" InputGestureText="Ctrl+I" Click="Italic_Click"/>
                <MenuItem Header="_Underline" InputGestureText="Ctrl+U" Click="Underline_Click"/>
                <Separator/>
                <MenuItem Header="Formatting _Bullets" Click="Bullets_Click"/>
                <MenuItem Header="_Numbered List" Click="Numbers_Click"/>
                <Separator/>
                <MenuItem Header="Align _Left" Click="AlignLeft_Click"/>
                <MenuItem Header="_Center" Click="AlignCenter_Click"/>
                <MenuItem Header="Align _Right" Click="AlignRight_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem x:Name="SpellMenu" Header="Check _Spelling As You Type" IsCheckable="True" IsChecked="True" Click="Spell_Click"/>
                <MenuItem Header="Select _Recipients..." Click="PickTo_Click"/>
            </MenuItem>
            <MenuItem Header="_Message">
                <MenuItem Header="Set _Priority">
                    <MenuItem x:Name="PriHighMenu" Header="_High" IsCheckable="True" Tag="1" Click="Priority_Click"/>
                    <MenuItem x:Name="PriNormalMenu" Header="_Normal" IsCheckable="True" IsChecked="True" Tag="3" Click="Priority_Click"/>
                    <MenuItem x:Name="PriLowMenu" Header="_Low" IsCheckable="True" Tag="5" Click="Priority_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border x:Name="CmdBar" DockPanel.Dock="Top" Style="{StaticResource CommandBar}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CmdButton}" Click="Send_Click" ToolTip="Send this message (Alt+S)">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconSend}" Width="20" Height="20"/><TextBlock Style="{StaticResource CmdLabel}" Text="Send"/></StackPanel>
                </Button>
                <Border Style="{StaticResource CmdSeparator}"/>
                <Button Style="{StaticResource CmdButton}" Click="Save_Click" ToolTip="Save this message in Drafts (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconSave}" Width="18" Height="18"/><TextBlock Style="{StaticResource CmdLabel}" Text="Save"/></StackPanel>
                </Button>
                <Button Style="{StaticResource CmdButton}" Click="Attach_Click" ToolTip="Attach a file">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconAttach}" Width="20" Height="20"/><TextBlock Style="{StaticResource CmdLabel}" Text="Attach"/></StackPanel>
                </Button>
                <Button x:Name="PriorityBtn" Style="{StaticResource CmdButton}" Click="PriorityBtn_Click" ToolTip="Set the priority of this message">
                    <StackPanel Orientation="Horizontal"><Image x:Name="PriorityImg" Source="{StaticResource IconPriorityHigh}" Width="18" Height="18"/><TextBlock Style="{StaticResource CmdLabel}" Text="Priority"/><TextBlock Text=" ▾" FontSize="9" VerticalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource CmdButton}" Click="SpellBtn_Click" ToolTip="Turn spell checking on or off">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconSpelling}" Width="18" Height="18"/><TextBlock Style="{StaticResource CmdLabel}" Text="Check"/></StackPanel>
                </Button>
                <Button Style="{StaticResource CmdButton}" Click="PickTo_Click" ToolTip="Choose recipients from your contacts">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconContacts}" Width="18" Height="18"/><TextBlock Style="{StaticResource CmdLabel}" Text="Contacts"/></StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="{DynamicResource PreviewHeaderBrush}" BorderBrush="#FFA9BBD1" BorderThickness="0,0,0,1" Padding="8,6,10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="BccRow" Height="0"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="AttachRow" Height="0"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="From:"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="FromBox" Height="23" Margin="0,0,0,4"/>

                <Button Grid.Row="1" Style="{StaticResource FmtButton}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="PickTo_Click" ToolTip="Select recipients">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconContacts}" Width="16" Height="16"/><TextBlock Text=" To:"/></StackPanel>
                </Button>
                <local:AddressBox Grid.Row="1" Grid.Column="1" x:Name="ToBox" Margin="0,0,0,4"/>

                <Button Grid.Row="2" Style="{StaticResource FmtButton}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="PickCc_Click" ToolTip="Select Cc recipients">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconContacts}" Width="16" Height="16"/><TextBlock Text=" Cc:"/></StackPanel>
                </Button>
                <local:AddressBox Grid.Row="2" Grid.Column="1" x:Name="CcBox" Margin="0,0,0,4"/>

                <Button Grid.Row="3" Style="{StaticResource FmtButton}" HorizontalAlignment="Left" Margin="0,0,0,4" Click="PickBcc_Click" ToolTip="Select Bcc recipients">
                    <StackPanel Orientation="Horizontal"><Image Source="{StaticResource IconContacts}" Width="16" Height="16"/><TextBlock Text=" Bcc:"/></StackPanel>
                </Button>
                <local:AddressBox Grid.Row="3" Grid.Column="1" x:Name="BccBox" Margin="0,0,0,4"/>

                <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Subject:" VerticalAlignment="Center"/>
                    <Image x:Name="PriorityMark" Source="{StaticResource IconPriorityHigh}" Width="14" Height="14" Margin="3,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SubjectBox" Height="23" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Attach:" Margin="0,6,8,0" VerticalAlignment="Top"/>
                <WrapPanel Grid.Row="5" Grid.Column="1" x:Name="AttachPanel" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="FormatBar" DockPanel.Dock="Top" Background="{DynamicResource LightBarBrush}" BorderBrush="#FFC5D2E0" BorderThickness="0,0,0,1" Padding="4,3" Visibility="Collapsed">
            <WrapPanel x:Name="FormatPanel">
                <ComboBox x:Name="FontBox" Width="160" Height="22" Margin="0,0,3,0" SelectionChanged="FontBox_SelectionChanged" ToolTip="Font"/>
                <ComboBox x:Name="SizeBox" Width="52" Height="22" Margin="0,0,6,0" SelectionChanged="SizeBox_SelectionChanged" ToolTip="Font Size"/>
                <ToggleButton x:Name="BoldBtn" Style="{StaticResource FmtButton}" Click="Bold_Click" ToolTip="Bold (Ctrl+B)">
                    <TextBlock Text="B" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="ItalicBtn" Style="{StaticResource FmtButton}" Click="Italic_Click" ToolTip="Italic (Ctrl+I)">
                    <TextBlock Text="I" FontStyle="Italic" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
                </ToggleButton>
                <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource FmtButton}" Click="Underline_Click" ToolTip="Underline (Ctrl+U)">
                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="ColorBtn" Style="{StaticResource FmtButton}" Click="Color_Click" ToolTip="Font Color">
                    <Grid>
                        <TextBlock Text="A" FontWeight="Bold" FontFamily="Times New Roman" FontSize="14" HorizontalAlignment="Center" Margin="0,-2,0,3"/>
                        <Rectangle x:Name="ColorSwatch" Height="4" Width="14" Fill="#FFE00000" VerticalAlignment="Bottom"/>
                    </Grid>
                </Button>
                <Border Width="1" Margin="4,3" Background="#FFB9C6D6"/>
                <Button Style="{StaticResource FmtButton}" Click="Bullets_Click" ToolTip="Formatting Bullets">
                    <Grid>
                        <Path Style="{StaticResource Glyph}" Data="M5,1.5 H14 M5,6 H14 M5,10.5 H14"/>
                        <Path Fill="#FF1E2A36" Data="M0,0.5 h2.5 v2.5 h-2.5 Z M0,5 h2.5 v2.5 h-2.5 Z M0,9.5 h2.5 v2.5 h-2.5 Z"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="Numbers_Click" ToolTip="Numbering">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="1" FontSize="9" VerticalAlignment="Center" Margin="0,0,1,0"/>
                        <Path Style="{StaticResource Glyph}" Width="11" Data="M2,1.5 H11 M2,6 H11 M2,10.5 H11"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="Outdent_Click" ToolTip="Decrease Indentation">
                    <Grid><Path Style="{StaticResource Glyph}" Data="M6,1.5 H14 M6,6 H14 M6,10.5 H14"/><Path Fill="#FF2B79D8" Data="M0,6 L4,3 V9 Z"/></Grid>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="Indent_Click" ToolTip="Increase Indentation">
                    <Grid><Path Style="{StaticResource Glyph}" Data="M6,1.5 H14 M6,6 H14 M6,10.5 H14"/><Path Fill="#FF2B79D8" Data="M4,6 L0,3 V9 Z"/></Grid>
                </Button>
                <Border Width="1" Margin="4,3" Background="#FFB9C6D6"/>
                <Button Style="{StaticResource FmtButton}" Click="AlignLeft_Click" ToolTip="Align Left">
                    <Path Style="{StaticResource Glyph}" Data="M0,0.5 H14 M0,4 H9 M0,7.5 H14 M0,11 H9"/>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="AlignCenter_Click" ToolTip="Center">
                    <Path Style="{StaticResource Glyph}" Data="M0,0.5 H14 M2.5,4 H11.5 M0,7.5 H14 M2.5,11 H11.5"/>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="AlignRight_Click" ToolTip="Align Right">
                    <Path Style="{StaticResource Glyph}" Data="M0,0.5 H14 M5,4 H14 M0,7.5 H14 M5,11 H14"/>
                </Button>
                <Border Width="1" Margin="4,3" Background="#FFB9C6D6"/>
                <Button Style="{StaticResource FmtButton}" Click="Rule_Click" ToolTip="Insert Horizontal Line">
                    <Path Style="{StaticResource Glyph}" Data="M0,6 H14" StrokeThickness="2"/>
                </Button>
                <Button Style="{StaticResource FmtButton}" Click="Link_Click" ToolTip="Create a Hyperlink">
                    <TextBlock Text="Link" Foreground="#FF0033CC" TextDecorations="Underline" FontSize="11"/>
                </Button>
            </WrapPanel>
        </Border>

        <RichTextBox x:Name="Editor" BorderThickness="0" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True" IsDocumentEnabled="True">
            <RichTextBox.Resources>
                <Style TargetType="{x:Type Paragraph}">
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>
    </DockPanel>
</local:VistaWindow>
